# Supabase 
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq 
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Places sync cron (server only, never prefix with VITE_). CRON_SECRET = any long random string
CRON_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# OpenRouteService — failover routing provider behind /api/route (server only, never
# prefix with VITE_: the whole point is this never reaches the client bundle). Free
# tier: https://openrouteservice.org/dev/#/signup. Routing works without this — it's
# only used if the free OSRM routers (the primary provider) are down or slow.
ORS_API_KEY=

# Always on in `npm run dev`. Set to 1 to enable god mode :)
VITE_DEV_PANEL=1

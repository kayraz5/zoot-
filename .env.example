# Supabase 
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq 
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Places sync cron (server only, never prefix with VITE_). CRON_SECRET = any long random string
CRON_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# OpenRouteService — failover routing provider behind /api/route (server only, never
# prefix with VITE_: the whole point is this never reaches the client bundle). Free
# tier: https://openrouteservice.org/dev/#/signup. Routing works without this — it's
# only used if the free OSRM routers (the primary provider) are down or slow.
ORS_API_KEY=

# Always on in `npm run dev`. Set to 1 to enable god mode :)
VITE_DEV_PANEL=1

# Supabase-gated tests (optional). Use dedicated test accounts only, never a personal one. 
# The first signed-in (Tier 1) run may create a profile row for each test account.
# Check what is set (only shows env var name) with `pnpm run test:env`.

# Set to 1 to skip every Supabase-gated test without sending any request
SKIP_SUPABASE=
# Dedicated test account that signs in for the social journeys (Tier 1 and up)
E2E_SUPABASE_EMAIL=
E2E_SUPABASE_PASSWORD=
# Second dedicated test account that hosts quests in two-account journeys
E2E_SUPABASE_HOST_EMAIL=
E2E_SUPABASE_HOST_PASSWORD=
# Set to 1 to let gated tests write as the test accounts (missions, quests, joins, chat, dev_simulate)
E2E_SUPABASE_WRITES=

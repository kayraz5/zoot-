# ── Zoot environment ─────────────────────────────────────────────
# Copy to .env (local) and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase (Kayra & Steven). Without this, only guest mode will be available.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq (server-only, read by /api/plan and /api/summary).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Show the /dev god-mode panel (fake GPS, skip time, force rain) in builds.
# Always on in `npm run dev`. Set to 1 to enable god-mode :)
VITE_DEV_PANEL=1
